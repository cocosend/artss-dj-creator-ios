{
  "name": "ARTSSNative",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx src modules/artss-audio/src",
    "test:core": "node scripts/test-core.mjs",
    "bundle:ios": "react-native bundle --platform ios --dev false --entry-file index.js --bundle-output build/main.jsbundle --assets-dest build/assets",
    "verify": "npm run typecheck && npm run lint && npm run test:core && npm run codegen:check && npm run bundle:ios",
    "codegen:check": "node node_modules/react-native/scripts/generate-codegen-artifacts.js -p . -o build/codegen-ios -t ios"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.84.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-reanimated": "4.2.2",
    "react-native-worklets": "0.7.4",
    "react-native-gesture-handler": "2.30.0",
    "@shopify/react-native-skia": "2.4.15",
    "react-native-artss-audio": "file:./modules/artss-audio"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.1",
    "@react-native/eslint-config": "0.84.1",
    "@react-native/metro-config": "0.84.1",
    "@react-native/typescript-config": "0.84.1",
    "@types/react": "19.2.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
